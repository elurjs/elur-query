{
  "name": "@elurjs/query",
  "version": "1.5.1",
  "description": "Query and cache utilities for Elur",
  "license": "MIT",
  "author": "Deiver Vasquez",
  "type": "module",
  "homepage": "https://github.com/elurjs/elur-query",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elurjs/elur-query.git"
  },
  "main": "./dist/lib/elur-query.cjs",
  "module": "./dist/lib/elur-query.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/elur-query.js",
      "require": "./dist/lib/elur-query.cjs",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "keywords": [
    "elur",
    "query",
    "command",
    "cqrs",
    "cache",
    "reactive",
    "typescript"
  ],
  "files": [
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean:lib": "rm -rf dist/lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json && terser dist/lib/elur-query.js -c -m -o dist/lib/elur-query.js && terser dist/lib/elur-query.cjs -c -m -o dist/lib/elur-query.cjs",
    "prepack": "npm run clean:lib && npm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@elurjs/core": "^2.5.3 || ^3.0.0"
  },
  "devDependencies": {
    "@elurjs/core": "3.5.0",
    "happy-dom": "^20.8.3",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  }
}